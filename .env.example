PORT=8080

# Cloudflare R2, S3-compatible API.
# Create a token with Object Read & Write on this bucket:
# https://developers.cloudflare.com/r2/api/tokens/
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=toggle

# Optional. Defaults to https://<R2_ACCOUNT_ID>.r2.cloudflarestorage.com
# Use the jurisdiction host for EU or FedRAMP buckets, for example
# https://<R2_ACCOUNT_ID>.eu.r2.cloudflarestorage.com
R2_ENDPOINT=

# Temporary process-local store. Leave unset when using R2.
# TOGGLE_R2_MEMORY=1

# Drop unreferenced blobs only after this many milliseconds. Default: 600000 (10 minutes).
# TOGGLE_GC_GRACE_MS=600000

# Largest accepted request body, in bytes. Default: 512 MiB.
# TOGGLE_MAX_BODY=536870912
